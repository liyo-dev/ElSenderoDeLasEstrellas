        {
            "id": "CAP3_PAJAROS_01",
            "text": "¡Guardia del cruce! Que nadie se mueva."
        },
        {
            "id": "CAP3_PAJAROS_02",
            "text": "Solo son pájaros…"
        },
        {
            "id": "CAP3_PAJAROS_03",
            "text": "Pájaros que no se venden. Atadlos."
        },
        {
            "id": "CAP3_PAJAROS_04",
            "text": "Ya está. Volad."
        },
        {
            "id": "CAP3_PAJAROS_05",
            "text": "Avisaste en vez de liarte a golpes. Eso, chico, es lo difícil."
        },
        {
            "id": "CAP3_PAJAROS_06",
            "text": "Si vas al Bosque Prohibido, ve de día. Y no toques nada que brille."
        },
        {
            "id": "CAP3_PAJAROS_07",
            "text": "Gracias. Lo haré."
        },
        {
            "id": "CAP3_JAULAS_01",
            "text": "Se acabó…"
        },
        {
            "id": "CAP3_JAULAS_02",
            "text": "Las jaulas… no, no, no."
        },
        {
            "id": "CAP3_JAULAS_03",
            "text": "Hemos visto el humo desde el cruce."
        },
        {
            "id": "CAP3_JAULAS_04",
            "text": "Tres jaulas quemadas. Los demás pájaros se salvarán."
        },
        {
            "id": "CAP3_JAULAS_05",
            "text": "Habría bastado con avisar, chico."
        },
        {
            "id": "CAP3_JAULAS_06",
            "text": "Lo sé."
        },
        {
            "id": "CAP3_JAULAS_07",
            "text": "Ve de día al Bosque Prohibido. Y piensa antes de arder."
        },
