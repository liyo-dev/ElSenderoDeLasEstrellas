  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 10d8708fd0f936346bad26dff04672db, type: 3}
  m_Name: DLG_CAP3_POSADERO_HOJA
  m_EditorClassIdentifier: Assembly-CSharp::DialogueAsset
  lines:
  - speakerNameId: CHAR_WILL
    textId: DLG_CAP3_HOJA_01
    text: Un zorro asustado, un perro que se rascaba y luces que respiran. Lo he apuntado todo.
    portrait: {fileID: 0}
    isPlayerSpeaking: 1
    lookAtOverrideId: 
    emotion: 0
  - speakerNameId: CHAR_POSADERO
    textId: DLG_CAP3_HOJA_02
    text: Se lo he contado a dos guardias y a un viajero. Ninguno me hizo caso.
    portrait: {fileID: 0}
    isPlayerSpeaking: 0
    lookAtOverrideId: 
    emotion: 0
  - speakerNameId: CHAR_POSADERO
    textId: DLG_CAP3_HOJA_03
    text: "T\xFA eres el primero que trae uno encima."
    portrait: {fileID: 0}
    isPlayerSpeaking: 0
    lookAtOverrideId: 
    emotion: 0
  - speakerNameId: CHAR_POSADERO
    textId: DLG_CAP3_HOJA_04
    text: Si buscas a quien hace esos aros, mira hacia el Bosque Prohibido.
    portrait: {fileID: 0}
    isPlayerSpeaking: 0
    lookAtOverrideId: 
    emotion: 0
  - speakerNameId: CHAR_POSADERO
    textId: DLG_CAP3_HOJA_05
    text: "Y no te f\xEDes del camino de noche. Por ah\xED pasan carros que no paran en ning\xFAn sitio."
    portrait: {fileID: 0}
    isPlayerSpeaking: 0
    lookAtOverrideId: 
    emotion: 9
  maxLinesPerPage: 0
  isGroupConversation: 0
