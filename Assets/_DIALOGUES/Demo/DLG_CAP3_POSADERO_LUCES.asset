  m_Script: {fileID: 11500000, guid: 10d8708fd0f936346bad26dff04672db, type: 3}
  m_Name: DLG_CAP3_POSADERO_LUCES
  m_EditorClassIdentifier: Assembly-CSharp::DialogueAsset
  lines:
  - speakerNameId: CHAR_POSADERO
    textId: DLG_CAP3_LUCES_01
    text: "Hace tres semanas, de noche, vi luces bajas movi\xE9ndose entre los \xE1rboles del bosque."
    portrait: {fileID: 0}
    isPlayerSpeaking: 0
    lookAtOverrideId: 
    emotion: 0
  - speakerNameId: CHAR_POSADERO
    textId: DLG_CAP3_LUCES_02
    text: No eran faroles. Iban a la altura de la rodilla.
    portrait: {fileID: 0}
    isPlayerSpeaking: 0
    lookAtOverrideId: 
    emotion: 0
  - speakerNameId: CHAR_WILL
    textId: DLG_CAP3_LUCES_03
    text: "\xBFY qu\xE9 hac\xEDan?"
    portrait: {fileID: 0}
    isPlayerSpeaking: 1
    lookAtOverrideId: 
    emotion: 0
  - speakerNameId: CHAR_POSADERO
    textId: DLG_CAP3_LUCES_04
    text: "Se encend\xEDan y se apagaban, despacio. Como algo que respira dormido."
    portrait: {fileID: 0}
    isPlayerSpeaking: 0
    lookAtOverrideId: 
    emotion: 9
  maxLinesPerPage: 0
  isGroupConversation: 0
