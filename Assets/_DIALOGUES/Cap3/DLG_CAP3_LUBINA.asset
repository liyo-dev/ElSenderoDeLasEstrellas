  lines:
  - speakerNameId: CHAR_WILL
    textId: DLG_CAP3_LUBINA_01
    text: "Ejem\u2026 \xBFDo\xF1a Lubina? Dice Pez que lo del martes fue un malentendido."
    portrait: {fileID: 0}
    isPlayerSpeaking: 1
    lookAtOverrideId: 
    emotion: 12
  - speakerNameId: CHAR_WILL
    textId: DLG_CAP3_LUBINA_02
    text: "\xA1Puaj!"
    portrait: {fileID: 0}
    isPlayerSpeaking: 1
    lookAtOverrideId: 
    emotion: 4
  - speakerNameId: CHAR_PEZ
    textId: DLG_CAP3_LUBINA_03
    text: "\xBFY bien? \xBFQu\xE9 ha dicho?"
    portrait: {fileID: 0}
    isPlayerSpeaking: 0
    lookAtOverrideId: 
    emotion: 13
  - speakerNameId: CHAR_WILL
    textId: DLG_CAP3_LUBINA_04
    text: "\u2026Me ha escupido."
    portrait: {fileID: 0}
    isPlayerSpeaking: 1
    lookAtOverrideId: 
    emotion: 14
  - speakerNameId: CHAR_PEZ
    textId: DLG_CAP3_LUBINA_05
    text: "\xA1Eso es que s\xED! Una dama."
    portrait: {fileID: 0}
    isPlayerSpeaking: 0
    lookAtOverrideId: 
    emotion: 1
