  m_Script: {fileID: 11500000, guid: 10d8708fd0f936346bad26dff04672db, type: 3}
  m_Name: DLG_CAP3_PEZ_ADIOS
  m_EditorClassIdentifier: Assembly-CSharp::DialogueAsset
  lines:
  - speakerNameId: CHAR_PEZ
    textId: DLG_CAP3_PEZ_ADIOS_01
    text: 'Sigue los barriles que flotan: te llevan a la casa del farol. Los peces los llaman boyas. Los peces son muy finos.'
    portrait: {fileID: 0}
    isPlayerSpeaking: 0
    lookAtOverrideId: 
    emotion: 0
  - speakerNameId: CHAR_PEZ
    textId: DLG_CAP3_PEZ_ADIOS_02
    text: "Candela lleva diez a\xF1os encendiendo ese farol. Los peces dicen que Andr\xE9s no va a volver."
    portrait: {fileID: 0}
    isPlayerSpeaking: 0
    lookAtOverrideId: 
    emotion: 2
  - speakerNameId: CHAR_PEZ
    textId: DLG_CAP3_PEZ_ADIOS_03
    text: Yo no se lo digo. Hay cosas que se oyen mejor con la luz encendida.
    portrait: {fileID: 0}
    isPlayerSpeaking: 0
    lookAtOverrideId: 
    emotion: 0
  maxLinesPerPage: 0
  isGroupConversation: 0
