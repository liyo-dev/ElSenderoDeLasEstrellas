  lines:
  - speakerNameId: CHAR_WILL
    textId: DLG_CAP3_PEZ_LECCION_01
    text: "Aqu\xED tienes tu lubina."
    portrait: {fileID: 0}
    isPlayerSpeaking: 1
    lookAtOverrideId: 
    emotion: 0
  - speakerNameId: CHAR_PEZ
    textId: DLG_CAP3_PEZ_LECCION_02
    text: "\xA1Capitana! El alumno est\xE1 listo. \xBFC\xF3mo dice? \xBFPies de sardina y brazos de pulpo? \xA1Pero solo tiene dos!"
    portrait: {fileID: 0}
    isPlayerSpeaking: 0
    lookAtOverrideId: 
    emotion: 13
  - speakerNameId: CHAR_PEZ
    textId: DLG_CAP3_PEZ_LECCION_03
    text: Dos bastan. Estira un brazo cada vez, da pataditas y gira la cabeza para respirar. La capitana dice que puedes.
    portrait: {fileID: 0}
    isPlayerSpeaking: 0
    lookAtOverrideId: 
    emotion: 1
  maxLinesPerPage: 0
  isGroupConversation: 0
