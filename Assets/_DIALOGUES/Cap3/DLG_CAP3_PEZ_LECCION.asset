--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 10d8708fd0f936346bad26dff04672db, type: 3}
  m_Name: DLG_CAP3_PEZ_LECCION
  m_EditorClassIdentifier: Assembly-CSharp::DialogueAsset
  lines:
  - speakerNameId: CHAR_PEZ
    textId: DLG_CAP3_PEZ_LECCION_01
    text: "Un trato es un trato. Lecci\xF3n de nataci\xF3n. Primero: piensa como un pez."
    portrait: {fileID: 0}
    isPlayerSpeaking: 0
    lookAtOverrideId: 
    emotion: 0
  - speakerNameId: CHAR_PEZ
    textId: DLG_CAP3_PEZ_LECCION_02
    text: "\u2026No. Todav\xEDa piensas como un chico. Se te nota en las orejas."
    portrait: {fileID: 0}
    isPlayerSpeaking: 0
    lookAtOverrideId: 
    emotion: 6
  - speakerNameId: CHAR_PEZ
    textId: DLG_CAP3_PEZ_LECCION_03
    text: Brazos como si aplaudieras a una sardina muy lejos. Piernas como si no te importara nada.
    portrait: {fileID: 0}
    isPlayerSpeaking: 0
    lookAtOverrideId: 
    emotion: 0
  - speakerNameId: CHAR_PEZ
    textId: DLG_CAP3_PEZ_LECCION_04
    text: Y respira cuando el mar no mire.
    portrait: {fileID: 0}
    isPlayerSpeaking: 0
    lookAtOverrideId: 
    emotion: 0
  - speakerNameId: CHAR_WILL
    textId: DLG_CAP3_PEZ_LECCION_05
    text: "\xBFY ya est\xE1?"
    portrait: {fileID: 0}
    isPlayerSpeaking: 1
    lookAtOverrideId: 
    emotion: 12
  - speakerNameId: CHAR_PEZ
    textId: DLG_CAP3_PEZ_LECCION_06
    text: "Por la autoridad que me dieron unas almejas que no recuerdo\u2026 \xA1te nombro pez de honor!"
    portrait: {fileID: 0}
    isPlayerSpeaking: 0
    lookAtOverrideId: 
    emotion: 13
  maxLinesPerPage: 0
  isGroupConversation: 0
