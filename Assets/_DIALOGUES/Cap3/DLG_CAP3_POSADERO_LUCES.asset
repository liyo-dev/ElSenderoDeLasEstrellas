  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 10d8708fd0f936346bad26dff04672db, type: 3}
  m_Name: DLG_CAP3_POSADERO_LUCES
  m_EditorClassIdentifier: Assembly-CSharp::DialogueAsset
  lines:
  - speakerNameId: CHAR_WILL
    textId: DLG_CAP3_LUCES_01
    text: "\xBFY usted ha visto alguno de esos animales?"
    portrait: {fileID: 0}
    isPlayerSpeaking: 1
    lookAtOverrideId: 
    emotion: 0
  - speakerNameId: CHAR_POSADERO
    textId: DLG_CAP3_LUCES_02
    text: "Animales no. Pero hace unas semanas, una noche que no pod\xEDa dormir, vi luces en el camino del bosque."
    portrait: {fileID: 0}
    isPlayerSpeaking: 0
    lookAtOverrideId: 
    emotion: 0
  - speakerNameId: CHAR_POSADERO
    textId: DLG_CAP3_LUCES_03
    text: No eran faroles. Iban casi a ras de suelo, todas juntas.
    portrait: {fileID: 0}
    isPlayerSpeaking: 0
    lookAtOverrideId: 
    emotion: 0
  - speakerNameId: CHAR_WILL
    textId: DLG_CAP3_LUCES_04
    text: "\xBFLuci\xE9rnagas?"
    portrait: {fileID: 0}
    isPlayerSpeaking: 1
    lookAtOverrideId: 
    emotion: 6
  - speakerNameId: CHAR_POSADERO
    textId: DLG_CAP3_LUCES_05
    text: "Las luci\xE9rnagas no se encienden todas a la vez. Aquello sub\xEDa y bajaba despacio\u2026 como algo que respira dormido."
    portrait: {fileID: 0}
    isPlayerSpeaking: 0
    lookAtOverrideId: 
    emotion: 9
  maxLinesPerPage: 0
  isGroupConversation: 0
