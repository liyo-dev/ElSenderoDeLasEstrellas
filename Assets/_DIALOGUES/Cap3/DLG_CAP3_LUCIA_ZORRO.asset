  m_Script: {fileID: 11500000, guid: 10d8708fd0f936346bad26dff04672db, type: 3}
  m_Name: DLG_CAP3_LUCIA_ZORRO
  m_EditorClassIdentifier: Assembly-CSharp::DialogueAsset
  lines:
  - speakerNameId: CHAR_LUCIA
    textId: DLG_CAP3_ZORRO_01
    text: "\xBFT\xFA tambi\xE9n buscas al zorro del collar? \xA1Yo lo vi!"
    portrait: {fileID: 0}
    isPlayerSpeaking: 0
    lookAtOverrideId: 
    emotion: 13
  - speakerNameId: CHAR_LUCIA
    textId: DLG_CAP3_ZORRO_02
    text: "Estaba en la cerca del huerto, rasc\xE1ndose el cuello contra la madera. As\xED, mira."
    portrait: {fileID: 0}
    isPlayerSpeaking: 0
    lookAtOverrideId: 
    emotion: 0
  - speakerNameId: CHAR_LUCIA
    textId: DLG_CAP3_ZORRO_03
    text: "Le dije \xABven, bonito\xBB y sali\xF3 corriendo. Creo que ten\xEDa m\xE1s miedo que yo."
    portrait: {fileID: 0}
    isPlayerSpeaking: 0
    lookAtOverrideId: 
    emotion: 2
  maxLinesPerPage: 0
  isGroupConversation: 0
