  m_Script: {fileID: 11500000, guid: 10d8708fd0f936346bad26dff04672db, type: 3}
  m_Name: DLG_CAP3_SARGENTO_PLUMA
  m_EditorClassIdentifier: Assembly-CSharp::DialogueAsset
  lines:
  - speakerNameId: CHAR_SARGENTO
    textId: DLG_CAP3_SARGENTO_01
    text: "\xBFContrabandistas? \xBFPor aqu\xED? Chico, vete a dormir."
    portrait: {fileID: 0}
    isPlayerSpeaking: 0
    lookAtOverrideId: 
    emotion: 14
  - speakerNameId: CHAR_WILL
    textId: DLG_CAP3_SARGENTO_02
    text: "Llevan p\xE1jaros en jaulas. Mire esto."
    portrait: {fileID: 0}
    isPlayerSpeaking: 1
    lookAtOverrideId: 
    emotion: 0
  - speakerNameId: CHAR_SARGENTO
    textId: DLG_CAP3_SARGENTO_03
    text: "Esto es una pluma de p\xE1jaro de luz. No se venden. No se pueden vender."
    portrait: {fileID: 0}
    isPlayerSpeaking: 0
    lookAtOverrideId: 
    emotion: 4
  - speakerNameId: CHAR_SARGENTO
    textId: DLG_CAP3_SARGENTO_04
    text: "Vosotros dos, conmigo. Y t\xFA, chico, ens\xE9\xF1anos el camino."
    portrait: {fileID: 0}
    isPlayerSpeaking: 0
    lookAtOverrideId: 
    emotion: 10
  maxLinesPerPage: 0
  isGroupConversation: 0
