  lines:
  - speakerNameId: CHAR_WILL
    textId: DLG_CAP3_COBERTIZO_01
    text: "Mira qu\xE9 ara\xF1azos. Aqu\xED se ha rascado otro animal, uno m\xE1s grande que el zorro."
    portrait: {fileID: 0}
    isPlayerSpeaking: 1
    lookAtOverrideId: 
    emotion: 6
  - speakerNameId: CHAR_WILL
    textId: DLG_CAP3_COBERTIZO_02
    text: "Y esto\u2026 son restos de hierro. Tienen las mismas rayas que mi trozo de aro."
    portrait: {fileID: 0}
    isPlayerSpeaking: 1
    lookAtOverrideId: 
    emotion: 0
  - speakerNameId: CHAR_WILL
    textId: DLG_CAP3_COBERTIZO_03
    text: "Todav\xEDa brillan."
    portrait: {fileID: 0}
    isPlayerSpeaking: 1
    lookAtOverrideId: 
    emotion: 4
  maxLinesPerPage: 0
  isGroupConversation: 0
