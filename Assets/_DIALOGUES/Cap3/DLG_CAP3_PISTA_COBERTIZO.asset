  m_Script: {fileID: 11500000, guid: 10d8708fd0f936346bad26dff04672db, type: 3}
  m_Name: DLG_CAP3_PISTA_COBERTIZO
  m_EditorClassIdentifier: Assembly-CSharp::DialogueAsset
  lines:
  - speakerNameId: CHAR_WILL
    textId: DLG_CAP3_COBERTIZO_01
    text: "Ara\xF1azos en la madera, a la altura del cuello de un perro."
    portrait: {fileID: 0}
    isPlayerSpeaking: 1
    lookAtOverrideId: 
    emotion: 6
  - speakerNameId: CHAR_WILL
    textId: DLG_CAP3_COBERTIZO_02
    text: "Ha dejado restos de hierro en la madera. Con las mismas l\xEDneas que el trozo del aro."
    portrait: {fileID: 0}
    isPlayerSpeaking: 1
    lookAtOverrideId: 
    emotion: 0
  - speakerNameId: CHAR_WILL
    textId: DLG_CAP3_COBERTIZO_03
    text: "Y las l\xEDneas todav\xEDa brillan un poco."
    portrait: {fileID: 0}
    isPlayerSpeaking: 1
    lookAtOverrideId: 
    emotion: 4
  maxLinesPerPage: 0
  isGroupConversation: 0
