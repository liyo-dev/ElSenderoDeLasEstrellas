%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 10d8708fd0f936346bad26dff04672db, type: 3}
  m_Name: DLG_CAP3_CANDELA
  m_EditorClassIdentifier: Assembly-CSharp::DialogueAsset
  lines:
  - speakerNameId: CHAR_CANDELA
    textId: DLG_CAP3_CANDELA_01
    text: "\xBFAndr\xE9s?\u2026 No. Perdona, muchacho. Cada vez que alguien sube esos escalones pienso que es \xE9l."
    portrait: {fileID: 0}
    isPlayerSpeaking: 0
    lookAtOverrideId: 
    emotion: 2
  - speakerNameId: CHAR_WILL
    textId: DLG_CAP3_CANDELA_02
    text: El posadero dice que usted ve el camino del bosque de noche.
    portrait: {fileID: 0}
    isPlayerSpeaking: 1
    lookAtOverrideId: 
    emotion: 0
  - speakerNameId: CHAR_CANDELA
    textId: DLG_CAP3_CANDELA_03
    text: "Desde aqu\xED se ve todo: el mar, el puerto y el camino que sube al bosque. Enciendo el farol cada noche, por si Andr\xE9s busca la casa."
    portrait: {fileID: 0}
    isPlayerSpeaking: 0
    lookAtOverrideId: 
    emotion: 0
  - speakerNameId: CHAR_CANDELA
    textId: DLG_CAP3_CANDELA_04
    text: "Hace tres noches pas\xF3 un carro sin farol. Dos hombres: uno grande, metido entre las varas, y otro delante, mirando a todos lados."
    portrait: {fileID: 0}
    isPlayerSpeaking: 0
    lookAtOverrideId: 
    emotion: 9
  - speakerNameId: CHAR_CANDELA
    textId: DLG_CAP3_CANDELA_05
    text: "Bajo la manta llevaban jaulas. Y dentro algo brillaba, se apagaba y volv\xEDa a brillar. Como mi farol cuando le falta aceite."
    portrait: {fileID: 0}
    isPlayerSpeaking: 0
    lookAtOverrideId: 
    emotion: 9
  - speakerNameId: CHAR_CANDELA
    textId: DLG_CAP3_CANDELA_06
    text: Salieron por el huerto, por donde la cerca, y subieron hacia el fuego del camino del bosque.
    portrait: {fileID: 0}
    isPlayerSpeaking: 0
    lookAtOverrideId: 
    emotion: 0
  - speakerNameId: CHAR_WILL
    textId: DLG_CAP3_CANDELA_07
    text: "Esta noche ir\xE9 a verlo."
    portrait: {fileID: 0}
    isPlayerSpeaking: 1
    lookAtOverrideId: 
    emotion: 10
  - speakerNameId: CHAR_CANDELA
    textId: DLG_CAP3_CANDELA_08
    text: "Ve. Y vuelve. Que aqu\xED ya esperamos bastante."
    portrait: {fileID: 0}
    isPlayerSpeaking: 0
    lookAtOverrideId: 
    emotion: 0
  maxLinesPerPage: 0
  isGroupConversation: 0
