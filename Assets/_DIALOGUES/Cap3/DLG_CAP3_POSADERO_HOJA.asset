%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 10d8708fd0f936346bad26dff04672db, type: 3}
  m_Name: DLG_CAP3_POSADERO_HOJA
  m_EditorClassIdentifier: Assembly-CSharp::DialogueAsset
  lines:
  - speakerNameId: CHAR_POSADERO
    textId: DLG_CAP3_HOJA_01
    text: "\xBFQu\xE9, chico? \xBFHas sacado algo en claro?"
    portrait: {fileID: 0}
    isPlayerSpeaking: 0
    lookAtOverrideId: 
    emotion: 0
  - speakerNameId: CHAR_WILL
    textId: DLG_CAP3_HOJA_02
    text: "El zorro de Luc\xEDa se rascaba contra la cerca hasta arrancarse el pelo. Y en la casa de las nasas, otro animal m\xE1s grande ha dejado restos de hierro."
    portrait: {fileID: 0}
    isPlayerSpeaking: 1
    lookAtOverrideId: 
    emotion: 6
  - speakerNameId: CHAR_WILL
    textId: DLG_CAP3_HOJA_03
    text: "Con las mismas rayas que esto. Y todav\xEDa brillan."
    portrait: {fileID: 0}
    isPlayerSpeaking: 1
    lookAtOverrideId: 
    emotion: 0
  - speakerNameId: CHAR_POSADERO
    textId: DLG_CAP3_HOJA_04
    text: "Llevo semanas cont\xE1ndolo y nadie me hace caso. Ni los guardias del cruce."
    portrait: {fileID: 0}
    isPlayerSpeaking: 0
    lookAtOverrideId: 
    emotion: 14
  - speakerNameId: CHAR_POSADERO
    textId: DLG_CAP3_HOJA_05
    text: "Y ahora apareces t\xFA con un trozo de esos aros en el bolsillo."
    portrait: {fileID: 0}
    isPlayerSpeaking: 0
    lookAtOverrideId: 
    emotion: 0
  - speakerNameId: CHAR_WILL
    textId: DLG_CAP3_HOJA_06
    text: Se lo voy a llevar a Estela, la hechicera del Bosque Prohibido. Con todo esto, a lo mejor me escucha.
    portrait: {fileID: 0}
    isPlayerSpeaking: 1
    lookAtOverrideId: 
    emotion: 10
  - speakerNameId: CHAR_POSADERO
    textId: DLG_CAP3_HOJA_07
    text: "\xBFAl Bosque Prohibido? Entonces vas por el camino del bosque\u2026 \xBFTe acuerdas de las luces que te cont\xE9?"
    portrait: {fileID: 0}
    isPlayerSpeaking: 0
    lookAtOverrideId: 
    emotion: 9
  - speakerNameId: CHAR_POSADERO
    textId: DLG_CAP3_HOJA_08
    text: Desde entonces he visto pasar carros por ese camino, siempre de noche y con la carga tapada. Las luces iban con ellos.
    portrait: {fileID: 0}
    isPlayerSpeaking: 0
    lookAtOverrideId: 
    emotion: 9
  - speakerNameId: CHAR_POSADERO
    textId: DLG_CAP3_HOJA_09
    text: "Si quieres saber de d\xF3nde salen esos aros, espera junto al fuego del camino y m\xEDralo con tus propios ojos."
    portrait: {fileID: 0}
    isPlayerSpeaking: 0
    lookAtOverrideId: 
    emotion: 0
  - speakerNameId: CHAR_WILL
    textId: DLG_CAP3_HOJA_10
    text: "Si esos carros llevan animales con aro, a Estela le llevar\xE9 algo m\xE1s que un trozo de hierro."
    portrait: {fileID: 0}
    isPlayerSpeaking: 1
    lookAtOverrideId: 
    emotion: 10
  maxLinesPerPage: 0
  isGroupConversation: 0
