  lines:
  - speakerNameId: CHAR_WILL
    textId: DLG_CAP3_HUERTO_01
    text: "Rodadas hondas que salen hacia el camino del bosque\u2026 Un carro muy cargado, y sin camino."
    portrait: {fileID: 0}
    isPlayerSpeaking: 1
    lookAtOverrideId: 
    emotion: 6
  - speakerNameId: CHAR_WILL
    textId: DLG_CAP3_HUERTO_02
    text: "Paja enganchada en la tabla rota. Todav\xEDa brilla un poco\u2026 como respira la luz que vio el posadero."
    portrait: {fileID: 0}
    isPlayerSpeaking: 1
    lookAtOverrideId: 
    emotion: 4
