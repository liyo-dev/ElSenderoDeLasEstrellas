  lines:
  - speakerNameId: CHAR_VICTORIA
    textId: DLG_CAP2_ADIOS_VICTORIA_01
    text: "\xBFYa te vas? Ay, Will\u2026 Come bien y abr\xEDgate por las noches."
    portrait: {fileID: 0}
    isPlayerSpeaking: 0
    lookAtOverrideId: 
    emotion: 2
  - speakerNameId: CHAR_VICTORIA
    textId: DLG_CAP2_ADIOS_VICTORIA_02
    text: Y no le hagas caso a Eldran si dice que no se preocupa. Se preocupa, y mucho.
    portrait: {fileID: 0}
    isPlayerSpeaking: 0
    lookAtOverrideId: 
    emotion: 1
  - speakerNameId: CHAR_WILL
    textId: DLG_CAP2_ADIOS_VICTORIA_03
    text: "Lo har\xE9, Victoria. Gracias por todo."
    portrait: {fileID: 0}
    isPlayerSpeaking: 1
    lookAtOverrideId: 
    emotion: 1
  maxLinesPerPage: 0
  isGroupConversation: 0
