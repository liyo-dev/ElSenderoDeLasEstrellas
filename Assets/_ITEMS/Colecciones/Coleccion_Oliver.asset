  coleccionId: OLIVER
  tituloId: COLECCION_OLIVER_TITULO
  titulo: "Colecci\xF3n de Oliver"
  paginas:
  - tituloId: COLECCION_OLIVER_PAGINA_1
    titulo: Cosas raras del pueblo
    piezas:
    - objeto: {fileID: 11400000, guid: b506d8c3a99c4c848b98f093d2b7e790, type: 2}
      fraseId: COLECCION_OLIVER_FRASE_CANICA
      frase: "\xA1Una canica de cielo! Sab\xEDa que exist\xEDan. Va en el centro de la p\xE1gina."
    - objeto: {fileID: 11400000, guid: 8b9e40e0965044d68c0cf3b75fe01534, type: 2}
      fraseId: COLECCION_OLIVER_FRASE_PIEDRA
      frase: "Si miras por el agujero, el pueblo parece otro. \xBFLo ves? Yo tampoco, pero da suerte."
    - objeto: {fileID: 11400000, guid: 6a7853d7975b431daa5d30a7de9f2e6f, type: 2}
      fraseId: COLECCION_OLIVER_FRASE_MONEDA
      frase: "No es de ning\xFAn reino que yo conozca. \xA1Mejor! Las cosas raras valen m\xE1s."
