/* Story editor — warm graphite neutrals, one accent (#FF7A45) for the story path, the selection
   and the main action. Step types only tint their label. */

.story-root {
    --accent: #FF7A45;
    --accent-ink: #1A120C;
    --bg: #141312;
    --panel: #181715;
    --raised: #1D1C1A;
    --card: #1F1D1B;
    --card-on: #262320;
    --line: #2B2926;
    --line-strong: #34312D;
    --text: #ECE7DF;
    --text-strong: #F3EEE6;
    --muted: #A39C92;
    --faint: #8F887F;
    --warning: #F0B24A;
    --ok: #A8D8B0;
    flex-grow: 1;
    background-color: var(--bg);
    color: var(--text);
    font-size: 12px;
}

.story-mono { color: var(--muted); -unity-font-style: bold; font-size: 11px; }
.story-kicker { font-size: 10px; -unity-font-style: bold; letter-spacing: 1px; color: var(--muted); margin-bottom: 4px; }
.story-muted { color: var(--faint); white-space: normal; font-size: 11px; margin-top: 2px; }
.story-key { font-size: 10px; color: var(--muted); border-width: 1px; border-color: #3A3733; border-radius: 3px; padding: 0 5px; }

/* Toolbar */
.story-toolbar {
    flex-direction: row;
    align-items: center;
    height: 44px;
    padding: 0 10px;
    background-color: var(--panel);
    border-bottom-width: 1px;
    border-bottom-color: var(--line);
}
.story-toolbar > #spacer { flex-grow: 1; }
.story-toolbar__graph { min-width: 200px; height: 30px; background-color: transparent; border-width: 0; -unity-font-style: bold; color: var(--text); }
.story-toolbar__search { flex-direction: row; align-items: center; width: 340px; margin-left: 10px; }
.story-toolbar__search > TextField { flex-grow: 1; margin: 0; }
.story-toolbar__search .unity-text-input,
.story-root TextField .unity-base-text-field__input {
    background-color: var(--raised);
    border-color: #2F2C29;
    border-radius: 5px;
    color: var(--text);
    min-height: 26px;
    padding: 0 8px;
}
.story-toolbar__search > Label { margin-left: 6px; }
.story-toolbar__status { background-color: transparent; border-width: 0; color: var(--ok); -unity-font-style: bold; margin-right: 8px; }
.story-toolbar__status.is-warning { color: var(--warning); }
.story-toolbar__saved { color: var(--muted); margin-right: 10px; }

.story-button {
    height: 28px;
    padding: 0 10px;
    margin-left: 6px;
    background-color: transparent;
    color: var(--text);
    border-width: 1px;
    border-color: #2F2C29;
    border-radius: 5px;
}
.story-button:hover { background-color: #262421; }
.story-button--primary {
    height: 28px;
    padding: 0 14px;
    margin-left: 8px;
    background-color: var(--accent);
    color: var(--accent-ink);
    border-width: 0;
    border-radius: 5px;
    -unity-font-style: bold;
}
.story-button--primary:hover { background-color: #FF9466; }
.story-button--primary:disabled { background-color: #2B2926; color: var(--muted); }

.story-body { flex-direction: row; flex-grow: 1; min-height: 0; }

/* Outline */
.story-outline {
    width: 240px;
    padding: 14px 10px 10px 10px;
    background-color: var(--panel);
    border-right-width: 1px;
    border-right-color: var(--line);
}
.story-outline__head { padding: 0 6px 12px 6px; flex-shrink: 0; }
.story-outline__title { font-size: 15px; -unity-font-style: bold; color: var(--text-strong); }
.story-outline__count { color: var(--muted); margin-top: 2px; }
.story-outline__add {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    height: 34px;
    padding: 0 10px;
    margin: 0 0 6px 0;
    background-color: transparent;
    border-width: 1px;
    border-color: #4A4640;
    border-radius: 5px;
    color: var(--text);
    -unity-font-style: bold;
}
.story-outline__add:hover { background-color: #262421; }
.story-outline__add-plus { color: var(--accent); font-size: 15px; -unity-font-style: bold; margin-right: 8px; }
.story-outline__add > #add-text { flex-grow: 1; }
.story-outline__tip { color: var(--faint); white-space: normal; font-size: 11px; padding: 0 6px 10px 6px; flex-shrink: 0; }
.story-outline__list { flex-grow: 1; }
.story-outline__section { flex-direction: row; align-items: center; padding: 10px 6px 4px 6px; }
.story-outline__section-name { flex-grow: 1; margin-left: 8px; -unity-font-style: bold; font-size: 11px; letter-spacing: 1px; color: #D9D3CA; }
.story-outline__row {
    flex-direction: row;
    align-items: center;
    height: 26px;
    padding: 0 6px;
    margin: 0;
    background-color: transparent;
    border-width: 0;
    border-radius: 4px;
    color: #E4DED5;
    -unity-text-align: middle-left;
}
.story-outline__row:hover { background-color: rgba(255, 240, 220, 0.05); }
.story-outline__row.is-selected { background-color: rgba(255, 122, 69, 0.14); }
.story-outline__row-number { width: 30px; -unity-font-style: bold; font-size: 11px; color: var(--faint); }
.story-outline__row.is-on-path .story-outline__row-number,
.story-outline__row.is-selected .story-outline__row-number { color: var(--accent); }
.story-outline__row-title { flex-grow: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.story-outline__word-group { padding: 12px 6px 4px 6px; }
.story-outline .story-segmented { flex-shrink: 0; margin: 0 6px 8px 6px; }
.story-outline__checkpoints { flex-shrink: 0; max-height: 40%; border-top-width: 1px; border-top-color: var(--line); padding-top: 10px; }

/* Canvas */
.story-canvas { flex-grow: 1; overflow: hidden; background-color: var(--bg); }
.story-canvas__content { position: absolute; left: 0; top: 0; width: 1px; height: 1px; overflow: visible; }
.story-canvas__layer { position: absolute; left: 0; top: 0; width: 1px; height: 1px; overflow: visible; }
.story-canvas__empty { position: absolute; left: 0; right: 0; top: 45%; -unity-text-align: middle-center; color: var(--muted); font-size: 14px; }

.story-canvas__zoom {
    position: absolute;
    right: 14px;
    bottom: 14px;
    flex-direction: row;
    align-items: center;
    padding: 3px;
    background-color: var(--panel);
    border-width: 1px;
    border-color: var(--line);
    border-radius: 6px;
}
.story-canvas__tool { height: 26px; min-width: 28px; margin: 0; background-color: transparent; border-width: 0; border-radius: 4px; color: var(--text); }
.story-canvas__tool:hover { background-color: #262421; }
.story-canvas__zoom-label { min-width: 46px; -unity-text-align: middle-center; color: #C9C2B8; font-size: 11px; }

/* Sections */
.story-section { position: absolute; flex-direction: row; align-items: center; height: 24px; }
.story-section__number { -unity-font-style: bold; color: var(--muted); font-size: 12px; margin-right: 10px; }
.story-section__name { -unity-font-style: bold; letter-spacing: 1px; color: #E4DED5; font-size: 13px; margin-right: 10px; }
.story-section__count { color: var(--muted); font-size: 12px; margin-right: 12px; }
.story-section__rule { flex-grow: 1; height: 1px; background-color: var(--line-strong); }

.story-name-field { position: absolute; width: 280px; margin: 0; }
.story-name-field > .unity-base-text-field__input {
    background-color: var(--panel);
    border-color: var(--accent);
    border-width: 1px;
    border-radius: 6px;
    padding: 4px 8px;
    font-size: 13px;
    color: var(--text-strong);
}

.story-canvas__box {
    position: absolute;
    display: none;
    background-color: rgba(255, 122, 69, 0.08);
    border-width: 1px;
    border-color: rgba(255, 122, 69, 0.6);
    border-radius: 2px;
}

/* Cards */
.story-card {
    position: absolute;
    padding: 10px 12px;
    background-color: var(--card);
    border-width: 1px;
    border-color: var(--line-strong);
    border-radius: 6px;
}
.story-card.is-selected { background-color: var(--card-on); border-color: var(--accent); border-width: 1.5px; }
.story-card.is-drop-target { border-color: var(--ok); border-width: 2px; }
.story-card.is-current { border-color: var(--ok); border-width: 2px; }
.story-card__breakpoint { display: none; width: 8px; height: 8px; border-radius: 4px; margin-right: 6px; background-color: #E5484D; }
.story-card.has-breakpoint .story-card__breakpoint { display: flex; }
.story-card.is-visited { opacity: 0.7; }
.story-card.is-dimmed { opacity: 0.28; }
.story-card--note { background-color: #2A2618; border-color: #4A4330; }

.story-card__header { flex-direction: row; align-items: center; margin-bottom: 4px; }
.story-card__number { -unity-font-style: bold; font-size: 12px; color: var(--faint); margin-right: 8px; }
.story-card.is-on-path .story-card__number,
.story-card.is-selected .story-card__number { color: var(--accent); }
.story-card.is-start .story-card__number { color: var(--accent); }
.story-card__type { flex-grow: 1; font-size: 10px; -unity-font-style: bold; letter-spacing: 1px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.story-card__warning { width: 9px; height: 9px; border-radius: 2px; background-color: var(--warning); rotate: 45deg; }
.story-card__title { font-size: 13px; -unity-font-style: bold; color: var(--text-strong); white-space: normal; max-height: 34px; overflow: hidden; }
.story-card__summary { font-size: 11px; color: #A9A298; margin-top: 3px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.story-card__outputs { flex-direction: row; position: absolute; left: 12px; bottom: 10px; }
.story-card__output {
    height: 22px;
    padding: 0 8px;
    margin-right: 6px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    font-size: 11px;
    color: #E4DED5;
    background-color: #1B1A18;
    border-width: 1px;
    border-color: #3A3733;
    border-radius: 4px;
}
.story-card__output.is-connected { border-color: var(--accent); }
.story-card__output:hover { border-color: var(--accent); background-color: #2A2724; }

.story-card__handle {
    position: absolute;
    width: 11px;
    height: 11px;
    background-color: var(--accent);
    border-width: 2px;
    border-color: var(--bg);
    border-radius: 3px;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.12s;
}
.story-card:hover .story-card__handle { opacity: 1; }
.story-card__handle--top { left: 104px; top: -6px; }
.story-card__handle--bottom { left: 104px; bottom: -6px; }
.story-card__handle--left { left: -6px; top: 42%; }
.story-card__handle--right { right: -6px; top: 42%; }

.story-canvas--mid .story-card__summary,
.story-canvas--mid .story-card__outputs,
.story-canvas--far .story-card__summary,
.story-canvas--far .story-card__outputs,
.story-canvas--far .story-card__header { display: none; }
.story-canvas--far .story-card__title { font-size: 26px; }

/* Connections */
.story-edge-label {
    position: absolute;
    translate: -50% -50%;
    padding: 1px 6px;
    background-color: var(--panel);
    border-width: 1px;
    border-radius: 4px;
    color: var(--text);
    font-size: 11px;
    -unity-font-style: bold;
}
.story-edge-insert {
    position: absolute;
    translate: -50% -50%;
    width: 18px;
    height: 18px;
    margin: 0;
    padding: 0;
    background-color: var(--panel);
    border-width: 1px;
    border-color: var(--accent);
    border-radius: 5px;
    color: var(--accent);
    font-size: 13px;
    -unity-font-style: bold;
    opacity: 0.45;
}
.story-edge-insert:hover { opacity: 1; }

/* Add step popup */
.story-popup {
    position: absolute;
    width: 330px;
    max-height: 420px;
    background-color: var(--raised);
    border-width: 1px;
    border-color: #3A3733;
    border-radius: 8px;
}
.story-popup__header { flex-direction: row; align-items: center; padding: 8px; border-bottom-width: 1px; border-bottom-color: #2F2C29; }
.story-popup__search { flex-grow: 1; margin: 0; }
.story-popup__close { width: 24px; height: 24px; margin: 0 0 0 6px; background-color: transparent; border-width: 0; color: var(--muted); font-size: 15px; }
.story-popup__hint { color: var(--muted); font-size: 11px; padding: 8px 12px 2px 12px; white-space: normal; }
.story-popup__list { flex-grow: 1; padding: 4px 6px 8px 6px; }
.story-popup__group { font-size: 10px; -unity-font-style: bold; letter-spacing: 1px; padding: 8px 8px 3px 8px; }
.story-popup__item {
    flex-direction: row;
    align-items: center;
    margin: 0;
    padding: 5px 8px;
    background-color: transparent;
    border-width: 0;
    border-radius: 5px;
    -unity-text-align: middle-left;
}
.story-popup__item:hover { background-color: #2A2724; }
.story-popup__item-title { color: var(--text-strong); -unity-font-style: bold; margin-right: 8px; }
.story-popup__item-desc { color: var(--muted); font-size: 11px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex-shrink: 1; }
.story-popup__empty { color: var(--muted); padding: 12px; }

/* Side panel */
.story-side { width: 360px; background-color: var(--panel); border-left-width: 1px; border-left-color: var(--line); }
.story-tabs { flex-direction: row; padding: 0 14px; border-bottom-width: 1px; border-bottom-color: var(--line); }
.story-tab {
    height: 40px;
    margin: 0 16px 0 0;
    padding: 0;
    background-color: transparent;
    border-width: 0 0 2px 0;
    border-radius: 0;
    border-color: transparent;
    color: var(--muted);
    -unity-font-style: bold;
}
.story-tab.is-on { color: var(--text-strong); border-bottom-color: var(--accent); }
.story-side__content { flex-grow: 1; }

.story-panel { flex-grow: 1; }
.story-panel__scroll { flex-grow: 1; padding: 16px 14px; }
.story-panel__head { margin-bottom: 12px; }
.story-row { flex-direction: row; align-items: center; }
.story-accent-number { color: var(--accent); -unity-font-style: bold; font-size: 15px; margin-right: 8px; }
.story-panel__title { font-size: 15px; -unity-font-style: bold; color: var(--text-strong); white-space: normal; flex-shrink: 1; }
.story-segmented { flex-direction: row; padding: 2px; margin-bottom: 12px; background-color: var(--raised); border-width: 1px; border-color: #2F2C29; border-radius: 6px; }
.story-segmented > Button { flex-grow: 1; height: 26px; margin: 0; background-color: transparent; border-width: 0; border-radius: 4px; color: var(--muted); -unity-font-style: bold; }
.story-segmented > Button.is-on { background-color: #34302B; color: var(--text-strong); }
.story-step-tab { flex-grow: 1; min-height: 0; }
.story-step-tab__warnings { padding: 10px 14px 0 14px; flex-shrink: 0; }
.story-notice { white-space: normal; padding: 8px 10px; margin-bottom: 12px; border-width: 1px; border-radius: 6px; }
.story-notice.is-ok { color: var(--ok); border-color: rgba(168, 216, 176, 0.35); background-color: rgba(168, 216, 176, 0.06); }
.story-notice.is-warning { color: #F3C77E; border-color: rgba(240, 178, 74, 0.35); background-color: rgba(240, 178, 74, 0.08); }
.story-panel__section { margin-bottom: 14px; }
.story-panel__row { flex-direction: row; align-items: center; min-height: 28px; border-top-width: 1px; border-top-color: var(--line); }
.story-panel__row.is-warning .story-panel__row-value { color: #F3C77E; }
.story-panel__row-name { width: 48%; min-width: 120px; color: var(--text-strong); -unity-font-style: bold; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.story-panel__row-value { flex-grow: 1; flex-shrink: 1; color: #E4DED5; white-space: normal; }
.story-panel__row-source { margin: 0; padding: 0 4px; background-color: transparent; border-width: 0; color: var(--muted); font-size: 11px; -unity-font-style: bold; }
.story-panel__row-source:hover { color: var(--accent); }

/* Assistant */
.story-assistant__input { flex-direction: row; align-items: flex-end; padding: 8px 10px; border-top-width: 1px; border-top-color: var(--line); flex-shrink: 0; }
.story-assistant__input > TextField { flex-grow: 1; flex-shrink: 1; min-height: 40px; margin: 0 6px 0 0; }
.story-assistant__bubble { white-space: normal; padding: 8px 10px; margin: 0 0 8px 0; border-radius: 8px; background-color: var(--raised); color: var(--text); }
.story-assistant__bubble.is-mine { background-color: rgba(255, 122, 69, 0.12); margin-left: 24px; }
.story-assistant__proposal { padding: 10px; margin-bottom: 8px; border-width: 1px; border-color: var(--accent); border-radius: 8px; }
.story-assistant__proposal > #title { -unity-font-style: bold; margin-bottom: 4px; color: var(--text-strong); }
.story-button { height: 26px; margin: 0 0 0 4px; padding: 0 10px; border-radius: 6px; background-color: var(--raised); border-color: var(--line-strong); color: var(--text); }
.story-button.is-primary { background-color: var(--accent); color: var(--accent-ink); border-width: 0; -unity-font-style: bold; }
