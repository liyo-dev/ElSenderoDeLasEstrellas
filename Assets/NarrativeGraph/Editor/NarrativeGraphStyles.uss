/* ═══════════════════════════════════════════════════════════════
   Guion narrativo — estilos del editor (Septiembre 2026)
   Paleta: fondo #1e2128 · paneles #262a33 · tarjetas #2b303a · texto #e6e8ee
   ═══════════════════════════════════════════════════════════════ */

.narrative-root {
    background-color: #1e2128;
    color: #e6e8ee;
}

.narrative-split {
    flex-grow: 1;
}

/* ─── Toolbar ─────────────────────────────────────────────────── */

.narrative-toolbar {
    flex-direction: row;
    align-items: center;
    height: 26px;
    padding: 0 6px;
    background-color: #262a33;
    border-bottom-width: 1px;
    border-bottom-color: #14161b;
}

.narrative-toolbar__separator {
    width: 1px;
    height: 16px;
    margin-left: 8px;
    margin-right: 8px;
    background-color: rgba(255, 255, 255, 0.12);
}

.narrative-toolbar__graph-menu {
    min-width: 170px;
    -unity-font-style: bold;
}

.narrative-toolbar__chapter-menu {
    min-width: 120px;
}

.narrative-toolbar__count,
.narrative-toolbar__search-count,
.narrative-toolbar__status {
    font-size: 11px;
    color: rgba(230, 232, 238, 0.6);
    margin-left: 6px;
}

.narrative-toolbar__status {
    margin-left: auto;
    margin-right: 8px;
    -unity-font-style: italic;
}

.narrative-toolbar__search {
    width: 220px;
}

.narrative-toolbar__save-btn {
    background-color: #3a7d44;
    color: white;
    border-radius: 4px;
    padding: 2px 14px;
    border-width: 0;
    -unity-font-style: bold;
}

.narrative-toolbar__save-btn:hover {
    background-color: #4a9d54;
}

.narrative-toolbar__play-btn {
    background-color: rgba(58, 125, 68, 0.25);
    color: #8fe39a;
    border-radius: 4px;
    padding: 2px 8px;
    border-width: 0;
    -unity-font-style: bold;
}

.narrative-toolbar__play-btn:hover {
    background-color: rgba(58, 125, 68, 0.45);
}

.narrative-toolbar__stop-btn {
    background-color: rgba(170, 55, 55, 0.2);
    color: #ff9b9b;
    border-radius: 4px;
    padding: 2px 8px;
    border-width: 0;
}

.narrative-toolbar__stop-btn:hover {
    background-color: rgba(170, 55, 55, 0.4);
}

.narrative-toolbar__stop-btn:disabled,
.narrative-toolbar__play-btn:disabled {
    opacity: 0.4;
}

/* ─── Paleta (izquierda) ──────────────────────────────────────── */

.narrative-palette {
    background-color: #262a33;
    border-right-width: 1px;
    border-right-color: #14161b;
    min-width: 170px;
}

.narrative-palette__title {
    font-size: 12px;
    -unity-font-style: bold;
    padding: 8px 10px 4px 10px;
    color: rgba(230, 232, 238, 0.85);
}

.narrative-palette__search {
    margin: 2px 8px 6px 8px;
    width: auto;
}

.narrative-palette__scroll {
    flex-grow: 1;
}

.narrative-palette__group {
    margin: 2px 4px;
}

.narrative-palette__group > Toggle {
    border-left-width: 3px;
    padding-left: 4px;
    -unity-font-style: bold;
    font-size: 11px;
}

.narrative-palette__item {
    margin: 1px 4px 1px 18px;
    padding: 3px 8px;
    border-radius: 4px;
    border-width: 0;
    border-left-width: 3px;
    background-color: #2b303a;
    -unity-text-align: middle-left;
    font-size: 11px;
    color: #e6e8ee;
}

.narrative-palette__item:hover {
    background-color: #3a404d;
}

.narrative-palette__help {
    font-size: 10px;
    color: rgba(230, 232, 238, 0.45);
    padding: 8px 10px;
    white-space: normal;
}

/* ─── Lienzo ──────────────────────────────────────────────────── */

GridBackground {
    --grid-background-color: #1b1e24;
    --line-color: rgba(255, 255, 255, 0.055);
    --thick-line-color: rgba(255, 255, 255, 0.10);
    --spacing: 24;
}

.narrative-minimap {
    background-color: rgba(30, 33, 40, 0.9);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    border-radius: 6px;
}

/* ─── Nodos ───────────────────────────────────────────────────── */

.narrative-node {
    min-width: 290px;
    max-width: 330px;
}

.narrative-node > #node-border {
    border-radius: 9px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.6);
    background-color: #262b34;
}

.narrative-node:hover > #node-border {
    border-color: rgba(255, 255, 255, 0.3);
}

.narrative-node:selected > #node-border,
.narrative-node:selected:hover > #node-border {
    border-color: #6fb1ff;
    border-width: 2px;
}

.narrative-node > #selection-border {
    border-radius: 10px;
}

.narrative-node__main {
    border-radius: 9px;
    background-color: #262b34;
}

.narrative-node__title-bar {
    height: 24px;
    min-height: 24px;
    padding: 2px 8px;
    flex-direction: row;
    align-items: center;
    border-radius: 8px 8px 0 0;
}

.narrative-node__type-title {
    font-size: 10px;
    -unity-font-style: bold;
    color: rgba(255, 255, 255, 0.92);
    margin: 0;
    padding: 0;
    overflow: hidden;
    text-overflow: ellipsis;
}

.narrative-node__start-badge {
    font-size: 9px;
    -unity-font-style: bold;
    color: #1e2128;
    background-color: #ffd54a;
    border-radius: 3px;
    padding: 1px 5px;
    margin-right: 5px;
}

.narrative-node__chapter-badge {
    font-size: 9px;
    -unity-font-style: bold;
    border-radius: 8px;
    padding: 1px 6px;
    margin-left: auto;
    color: white;
    white-space: nowrap;
    max-width: 92px;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* ▶ de la tarjeta: aparece al pasar el ratón y lanza una prueba desde ese nodo. */
.narrative-node__test-button {
    display: none;
    width: 18px;
    height: 18px;
    min-width: 18px;
    margin: 0 0 0 4px;
    padding: 0;
    border-width: 0;
    border-radius: 9px;
    background-color: rgba(255, 255, 255, 0.14);
    color: #f2f3f7;
    font-size: 9px;
    -unity-text-align: middle-center;
}

.narrative-node:hover .narrative-node__test-button {
    display: flex;
}

.narrative-node__test-button:hover {
    background-color: #3a7d44;
    color: white;
}

.narrative-node--note .narrative-node__test-button {
    display: none;
}

.narrative-node__label-row {
    padding: 3px 10px 1px 10px;
    background-color: rgba(0, 0, 0, 0.14);
}

.narrative-node__label-field {
    margin: 0;
}

.narrative-node__label-field > #unity-text-input {
    background-color: transparent;
    border-width: 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.10);
    border-radius: 0;
    padding: 1px 2px;
    font-size: 13px;
    -unity-font-style: bold;
    color: #f2f3f7;
}

.narrative-node__label-field > #unity-text-input:hover {
    border-bottom-color: rgba(255, 255, 255, 0.35);
}

.narrative-node__extension {
    padding: 2px 10px 7px 10px;
    background-color: #262b34;
    border-radius: 0 0 8px 8px;
}

/* Sin franja de puertos: los docks son bolitas absolutas en el borde de la tarjeta y no
   consumen una fila de alto. Los nodos con puertos con nombre (Sí/No) reservan espacio a la
   derecha para que sus etiquetas no pisen el resumen. */
.narrative-node #node-border #contents > #top {
    background-color: transparent;
    height: auto;
    min-height: 0;
    margin: 0;
    padding: 0;
    overflow: visible;
}

.narrative-node #node-border #contents > #top > #input,
.narrative-node #node-border #contents > #top > #output {
    background-color: transparent;
    position: relative;
    padding: 0;
    margin: 0;
    min-width: 0;
    min-height: 0;
    flex-direction: column;
}

.narrative-node #node-border #contents > #top > #input {
    align-items: flex-start;
    margin-left: -2px;
}

.narrative-node #node-border #contents > #top > #output {
    align-items: flex-end;
    margin-right: -2px;
}

.narrative-node #contents > #divider {
    display: none;
}

.narrative-node--note > #node-border {
    background-color: #3a3520;
}

.narrative-node--note .narrative-node__main,
.narrative-node--note .narrative-node__extension,
.narrative-node--note #contents > #top {
    background-color: #3a3520;
}

.narrative-node--obsolete {
    opacity: 0.6;
}

.narrative-node--dimmed {
    opacity: 0.18;
}

.narrative-node--search-match > #node-border {
    border-color: #ffd54a;
    border-width: 2px;
}

.narrative-node--has-warnings > #node-border {
    border-color: rgba(255, 170, 60, 0.7);
}

/* Nodo que está ejecutándose ahora mismo (Play Mode). */
.narrative-node--current > #node-border,
.narrative-node--current:selected > #node-border {
    border-color: #ffd54a;
    border-width: 3px;
}

.narrative-node--current > #selection-border {
    border-color: #ffd54a;
}

.narrative-node--visited > #node-border {
    border-color: rgba(143, 227, 154, 0.5);
}

.narrative-node--current > #node-border {
    border-color: #ffd54a;
}

.narrative-node__live-badge {
    display: none;
    font-size: 10px;
    color: #ffd54a;
    margin-right: 4px;
    -unity-font-style: bold;
}

.narrative-node--current .narrative-node__live-badge {
    display: flex;
}

/* ─── Resumen dentro del nodo ─────────────────────────────────── */

.narrative-node__summary {
    max-height: 68px;
    overflow: hidden;
}

.narrative-summary {
    padding-top: 2px;
}

.summary__text {
    font-size: 11px;
    white-space: normal;
    color: #dfe2ea;
    margin: 1px 0;
}

.summary__strong {
    -unity-font-style: bold;
    color: #f4f5f9;
}

.summary__muted {
    font-size: 10px;
    color: rgba(223, 226, 234, 0.55);
    white-space: normal;
    margin: 1px 0;
}

.summary__error {
    font-size: 10px;
    color: #ff7a7a;
    white-space: normal;
}

.summary__warn {
    font-size: 10px;
    color: #ffb054;
    white-space: normal;
}

.summary__asset-name {
    font-size: 11px;
    -unity-font-style: bold;
    color: #9ed0ff;
}

.summary__dialogue-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 3px;
}

.summary__line {
    flex-direction: row;
    margin: 1px 0;
}

.summary__speaker {
    font-size: 11px;
    -unity-font-style: bold;
    margin-right: 5px;
    min-width: 46px;
}

.summary__speaker--player {
    color: #ffd27a;
}

.summary__speaker--npc {
    color: #9ed0ff;
}

.summary__line > .summary__text {
    flex-shrink: 1;
    flex-grow: 1;
}

.summary__step {
    font-size: 10px;
    color: rgba(223, 226, 234, 0.7);
    white-space: normal;
    margin-left: 4px;
}

.summary__step--hi {
    color: #8fe39a;
    -unity-font-style: bold;
}

.summary__kv {
    flex-direction: row;
    margin: 1px 0;
}

.summary__kv-key {
    font-size: 10px;
    color: rgba(223, 226, 234, 0.55);
    margin-right: 5px;
    min-width: 44px;
}

.summary__kv-value {
    font-size: 11px;
    color: #dfe2ea;
    white-space: normal;
    flex-shrink: 1;
}

.summary__note {
    font-size: 11px;
    white-space: normal;
    color: #f2ecc8;
}

.chip {
    font-size: 10px;
    -unity-font-style: bold;
    border-radius: 9px;
    padding: 2px 8px;
    align-self: flex-start;
    background-color: rgba(255, 255, 255, 0.10);
    color: #e6e8ee;
    margin: 1px 0;
}

.chip--wait {
    background-color: rgba(120, 100, 220, 0.35);
}

.chip--raise {
    background-color: rgba(90, 160, 240, 0.35);
}

.chip--muted {
    background-color: rgba(255, 255, 255, 0.06);
    color: rgba(230, 232, 238, 0.6);
}

/* ─── Avisos en el nodo ───────────────────────────────────────── */

.narrative-node__warnings {
    margin-top: 4px;
    padding: 3px 6px;
    border-radius: 4px;
    background-color: rgba(255, 170, 60, 0.12);
}

.narrative-node__warning {
    font-size: 10px;
    color: #ffb054;
    white-space: normal;
}

/* ─── Puertos ─────────────────────────────────────────────────── */

.narrative-port-dock {
    padding: 0;
    margin: 0;
    min-width: 0;
    min-height: 0;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
}

.narrative-port-dock--right {
    align-items: flex-end;
}

.narrative-port {
    height: 15px;
    margin: 0;
    padding: 0;
}

.narrative-port > #connector {
    width: 10px;
    height: 10px;
    border-radius: 5px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.5);
    background-color: #1e2128;
}

.narrative-port:hover > #connector {
    background-color: #e6e8ee;
    border-color: #ffffff;
}

.narrative-port > #type {
    font-size: 10px;
    color: rgba(230, 232, 238, 0.8);
    margin: 0 3px;
}

.narrative-port--named > #type {
    -unity-font-style: bold;
}

/* Sí / No (y equivalentes) con color propio: se leen de un vistazo. */
.narrative-port--positive > #connector {
    border-color: #6fdc8c;
    background-color: rgba(111, 220, 140, 0.18);
}

.narrative-port--positive > #type {
    color: #8fe39a;
}

.narrative-port--negative > #connector {
    border-color: #ff7a7a;
    background-color: rgba(255, 122, 122, 0.16);
}

.narrative-port--negative > #type {
    color: #ff9b9b;
}

.narrative-node__fork-badge {
    font-size: 9px;
    -unity-font-style: bold;
    color: #1e2128;
    background-color: #ffb054;
    border-radius: 3px;
    padding: 1px 5px;
    margin: 0 0 4px 0;
    align-self: flex-start;
}

/* ─── Nivel de detalle por zoom ───────────────────────────────── */

/* De cerca: tarjeta completa. A media distancia: título + etiqueta. De lejos: solo título
   grande, para que el mapa del grafo se lea aunque el texto esté a 0,4×. */
.narrative-view--mid .narrative-node__summary,
.narrative-view--mid .narrative-node__warnings,
.narrative-view--mid .narrative-node__extension {
    display: none;
}

.narrative-view--mid .narrative-node__type-title {
    font-size: 13px;
}

.narrative-view--mid .narrative-node__label-field > #unity-text-input {
    font-size: 12px;
}

.narrative-view--far .narrative-node__label-row,
.narrative-view--far .narrative-node__extension,
.narrative-view--far .narrative-node__chapter-badge {
    display: none;
}

.narrative-view--far .narrative-node__title-bar {
    height: 38px;
    min-height: 38px;
    padding: 5px 10px;
    border-radius: 9px;
}

.narrative-view--far .narrative-node__type-title {
    font-size: 19px;
}

.narrative-view--far .narrative-node__start-badge {
    font-size: 13px;
    padding: 2px 6px;
}

.narrative-view--far .narrative-node__test-button {
    margin-left: auto;
}

/* A esa distancia las etiquetas Sí/No no se leen: quedan solo las bolitas. */
.narrative-view--far .narrative-port--named > #type {
    display: none;
}

/* ─── Aristas ─────────────────────────────────────────────────── */

.narrative-edge--dimmed {
    opacity: 0.1;
}

/* ─── Inspector (derecha) ─────────────────────────────────────── */

.narrative-inspector {
    background-color: #262a33;
    border-left-width: 1px;
    border-left-color: #14161b;
    min-width: 280px;
}

.narrative-inspector__header {
    font-size: 13px;
    -unity-font-style: bold;
    padding: 8px 10px;
    border-left-width: 5px;
    background-color: #2b303a;
    border-bottom-width: 1px;
    border-bottom-color: #14161b;
}

.narrative-inspector__scroll {
    flex-grow: 1;
}

.narrative-inspector__description {
    font-size: 11px;
    color: rgba(230, 232, 238, 0.6);
    white-space: normal;
    padding: 6px 10px 2px 10px;
    -unity-font-style: italic;
}

.narrative-inspector__hint {
    font-size: 11px;
    color: rgba(230, 232, 238, 0.55);
    white-space: normal;
    padding: 12px;
}

.narrative-inspector__section {
    margin: 4px 6px;
}

.narrative-inspector__section > Toggle {
    -unity-font-style: bold;
    font-size: 11px;
}

.narrative-inspector__section > #unity-content {
    padding: 4px 2px 6px 8px;
    margin-left: 0;
}

.narrative-inspector__row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin: 2px 0;
}

.narrative-inspector__asset-name {
    font-size: 12px;
    -unity-font-style: bold;
    color: #9ed0ff;
    white-space: normal;
    flex-shrink: 1;
}

.narrative-inspector__script {
    margin-top: 4px;
    padding: 4px;
    border-radius: 4px;
    background-color: rgba(0, 0, 0, 0.2);
}

.narrative-inspector__script-line {
    flex-direction: row;
    padding: 3px 2px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.05);
}

.narrative-inspector__script-num {
    font-size: 10px;
    color: rgba(230, 232, 238, 0.4);
    min-width: 18px;
    margin-right: 4px;
}

.narrative-inspector__link {
    -unity-text-align: middle-left;
    margin: 1px 0;
    padding: 2px 6px;
    font-size: 11px;
    background-color: rgba(255, 255, 255, 0.06);
    border-width: 0;
    border-radius: 3px;
    white-space: normal;
}

.narrative-inspector__link:hover {
    background-color: rgba(255, 255, 255, 0.14);
}

/* ─── Panel derecho con pestañas ─────────────────────────────── */

.narrative-side {
    flex-grow: 1;
    flex-direction: column;
    min-width: 280px;
    background-color: #262a33;
}

.narrative-side__tabs {
    flex-direction: row;
    height: 26px;
    flex-shrink: 0;
    background-color: #1e2128;
    border-bottom-width: 1px;
    border-bottom-color: #14161b;
}

.narrative-side__tab {
    flex-grow: 1;
    height: 26px;
    margin: 0;
    padding: 0 10px;
    border-width: 0;
    border-radius: 0;
    background-color: transparent;
    color: rgba(230, 232, 238, 0.55);
    font-size: 11px;
    -unity-text-align: middle-center;
}

.narrative-side__tab:hover {
    background-color: rgba(255, 255, 255, 0.05);
    color: #e6e8ee;
}

.narrative-side__tab.is-selected {
    background-color: #2b303a;
    color: #ffffff;
    -unity-font-style: bold;
    border-bottom-width: 2px;
    border-bottom-color: #6fb1ff;
}

.narrative-inspector,
.narrative-test {
    flex-grow: 1;
    min-height: 0;
}

/* ─── Pestaña Prueba ─────────────────────────────────────────── */

.narrative-test {
    background-color: #262a33;
}

.narrative-test__scroll {
    flex-grow: 1;
    padding: 6px 8px;
}

.narrative-test__title {
    font-size: 13px;
    -unity-font-style: bold;
    padding: 4px 2px 2px 2px;
    color: #f2f3f7;
}

.narrative-test__target {
    font-size: 11px;
    color: #9ed0ff;
    padding: 0 2px 8px 2px;
    white-space: normal;
}

.narrative-test__section {
    margin: 4px 0;
}

.narrative-test__section > Toggle {
    -unity-font-style: bold;
    font-size: 11px;
}

.narrative-test__hint {
    font-size: 10px;
    color: rgba(230, 232, 238, 0.55);
    white-space: normal;
    margin: 2px 0 6px 0;
}

.narrative-test__small-button {
    margin: 3px 0;
    font-size: 10px;
    height: 20px;
}

.narrative-test__grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.narrative-test__ability {
    width: 50%;
    font-size: 10px;
}

.narrative-test__preview {
    margin-top: 4px;
}

.narrative-test__preview-line {
    font-size: 10px;
    white-space: normal;
    margin: 1px 0;
}

.narrative-test__preview-line.is-ok { color: #8fe39a; }
.narrative-test__preview-line.is-warning { color: #ffb054; }
.narrative-test__preview-line.is-error { color: #ff7a7a; }
.narrative-test__preview-line.is-muted { color: rgba(230, 232, 238, 0.55); }

.narrative-test__actions {
    margin-top: 14px;
}

.narrative-test__play {
    height: 34px;
    border-width: 0;
    border-radius: 4px;
    background-color: #3a7d44;
    color: white;
    -unity-font-style: bold;
    font-size: 12px;
}

.narrative-test__play:hover {
    background-color: #4a9d54;
}

.narrative-test__play.is-playing {
    background-color: #a33f3f;
}

.narrative-test__status {
    font-size: 10px;
    color: rgba(230, 232, 238, 0.6);
    white-space: normal;
    margin-top: 6px;
    padding-bottom: 8px;
}

/* ─── Pestaña En vivo ────────────────────────────────────────── */

.narrative-live {
    flex-grow: 1;
    min-height: 0;
    background-color: #262a33;
}

.narrative-live__scroll {
    flex-grow: 1;
    padding: 6px 8px;
}

.narrative-live__title {
    font-size: 13px;
    -unity-font-style: bold;
    padding: 4px 2px 6px 2px;
    color: #f2f3f7;
}

.narrative-live__hint {
    font-size: 10px;
    color: rgba(230, 232, 238, 0.55);
    white-space: normal;
    padding: 2px;
}

.narrative-live__playing {
    flex-direction: column;
}

.narrative-live__headline {
    font-size: 10px;
    -unity-font-style: bold;
    color: #8fe39a;
    margin-bottom: 4px;
}

.narrative-live__current {
    font-size: 12px;
    -unity-font-style: bold;
    color: #ffd54a;
    white-space: normal;
    margin-bottom: 6px;
}

.narrative-live__line {
    font-size: 11px;
    color: #dfe2ea;
    white-space: normal;
    margin: 1px 0;
}

.narrative-live__section {
    margin: 4px 0;
}

.narrative-live__section > Toggle {
    -unity-font-style: bold;
    font-size: 11px;
}

.narrative-live__list {
    flex-direction: column;
}

.narrative-live__row {
    font-size: 10px;
    color: rgba(223, 226, 234, 0.8);
    white-space: normal;
    margin: 1px 0;
}

.narrative-live__muted {
    font-size: 10px;
    color: rgba(230, 232, 238, 0.45);
    white-space: normal;
}

.narrative-test__warning {
    font-size: 10px;
    color: #ffb054;
    white-space: normal;
    margin: 2px 0 4px 0;
}

/* ─── Selector de habilidades del nodo ───────────────────────── */

.unlock-editor {
    margin-top: 6px;
    padding-top: 6px;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.08);
}

.unlock-editor__title {
    font-size: 10px;
    -unity-font-style: bold;
    color: rgba(230, 232, 238, 0.7);
    margin: 6px 0 3px 0;
}

.unlock-editor__chips {
    flex-direction: row;
    flex-wrap: wrap;
}

.unlock-editor__chip {
    margin: 2px 4px 2px 0;
    padding: 2px 7px;
    border-width: 0;
    border-radius: 9px;
    background-color: rgba(111, 177, 255, 0.16);
    color: #cfe6ff;
    font-size: 10px;
}

.unlock-editor__chip:hover {
    background-color: rgba(255, 122, 122, 0.25);
    color: #ffd0d0;
}

.unlock-editor__add {
    flex-direction: row;
    align-items: center;
    margin: 3px 0;
}

.unlock-editor__dropdown {
    flex-grow: 1;
    margin-right: 4px;
}

.unlock-editor__add-button {
    width: 26px;
    height: 20px;
    min-width: 26px;
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 4px;
    background-color: #3a7d44;
    color: white;
    -unity-font-style: bold;
}

.unlock-editor__add-button:hover {
    background-color: #4a9d54;
}
