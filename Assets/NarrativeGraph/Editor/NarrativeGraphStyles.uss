/* ═══════════════════════════════════════════════════════════════
   Guion narrativo — estilos del editor (Septiembre 2026)
   Paleta: fondo #1e2128 · paneles #262a33 · tarjetas #2b303a · texto #e6e8ee
   ═══════════════════════════════════════════════════════════════ */

.narrative-root {
    background-color: #1e2128;
    color: #e6e8ee;
}

.narrative-split {
    flex-grow: 1;
}

/* ─── Toolbar ─────────────────────────────────────────────────── */

.narrative-toolbar {
    flex-direction: row;
    align-items: center;
    height: 26px;
    padding: 0 6px;
    background-color: #262a33;
    border-bottom-width: 1px;
    border-bottom-color: #14161b;
}

.narrative-toolbar__separator {
    width: 1px;
    height: 16px;
    margin-left: 8px;
    margin-right: 8px;
    background-color: rgba(255, 255, 255, 0.12);
}

.narrative-toolbar__graph-menu {
    min-width: 170px;
    -unity-font-style: bold;
}

.narrative-toolbar__chapter-menu {
    min-width: 120px;
}

.narrative-toolbar__count,
.narrative-toolbar__search-count,
.narrative-toolbar__status {
    font-size: 11px;
    color: rgba(230, 232, 238, 0.6);
    margin-left: 6px;
}

.narrative-toolbar__status {
    margin-left: auto;
    margin-right: 8px;
    -unity-font-style: italic;
}

.narrative-toolbar__search {
    width: 220px;
}

.narrative-toolbar__save-btn {
    background-color: #3a7d44;
    color: white;
    border-radius: 4px;
    padding: 2px 14px;
    border-width: 0;
    -unity-font-style: bold;
}

.narrative-toolbar__save-btn:hover {
    background-color: #4a9d54;
}

/* ─── Paleta (izquierda) ──────────────────────────────────────── */

.narrative-palette {
    background-color: #262a33;
    border-right-width: 1px;
    border-right-color: #14161b;
    min-width: 170px;
}

.narrative-palette__title {
    font-size: 12px;
    -unity-font-style: bold;
    padding: 8px 10px 4px 10px;
    color: rgba(230, 232, 238, 0.85);
}

.narrative-palette__search {
    margin: 2px 8px 6px 8px;
    width: auto;
}

.narrative-palette__scroll {
    flex-grow: 1;
}

.narrative-palette__group {
    margin: 2px 4px;
}

.narrative-palette__group > Toggle {
    border-left-width: 3px;
    padding-left: 4px;
    -unity-font-style: bold;
    font-size: 11px;
}

.narrative-palette__item {
    margin: 1px 4px 1px 18px;
    padding: 3px 8px;
    border-radius: 4px;
    border-width: 0;
    border-left-width: 3px;
    background-color: #2b303a;
    -unity-text-align: middle-left;
    font-size: 11px;
    color: #e6e8ee;
}

.narrative-palette__item:hover {
    background-color: #3a404d;
}

.narrative-palette__help {
    font-size: 10px;
    color: rgba(230, 232, 238, 0.45);
    padding: 8px 10px;
    white-space: normal;
}

/* ─── Lienzo ──────────────────────────────────────────────────── */

GridBackground {
    --grid-background-color: #1e2128;
    --line-color: rgba(255, 255, 255, 0.04);
    --thick-line-color: rgba(255, 255, 255, 0.08);
    --spacing: 24;
}

.narrative-minimap {
    background-color: rgba(30, 33, 40, 0.9);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    border-radius: 6px;
}

/* ─── Nodos ───────────────────────────────────────────────────── */

.narrative-node {
    min-width: 280px;
    max-width: 340px;
}

.narrative-node > #node-border {
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.55);
    background-color: #2b303a;
}

.narrative-node:hover > #node-border {
    border-color: rgba(255, 255, 255, 0.28);
}

.narrative-node:selected > #node-border,
.narrative-node:selected:hover > #node-border {
    border-color: #6fb1ff;
    border-width: 2px;
}

.narrative-node > #selection-border {
    border-radius: 9px;
}

.narrative-node__main {
    border-radius: 8px;
    background-color: #2b303a;
}

.narrative-node__title-bar {
    height: auto;
    min-height: 26px;
    padding: 3px 8px;
    flex-direction: row;
    align-items: center;
    border-radius: 7px 7px 0 0;
}

.narrative-node__type-title {
    font-size: 11px;
    -unity-font-style: bold;
    color: rgba(255, 255, 255, 0.95);
    margin: 0;
    padding: 0;
}

.narrative-node__start-badge {
    font-size: 9px;
    -unity-font-style: bold;
    color: #1e2128;
    background-color: #ffd54a;
    border-radius: 3px;
    padding: 1px 5px;
    margin-right: 6px;
}

.narrative-node__chapter-badge {
    font-size: 9px;
    -unity-font-style: bold;
    border-radius: 8px;
    padding: 1px 7px;
    margin-left: auto;
    color: white;
    white-space: nowrap;
    max-width: 110px;
    overflow: hidden;
    text-overflow: ellipsis;
}

.narrative-node__label-row {
    padding: 4px 8px 2px 8px;
    background-color: rgba(0, 0, 0, 0.18);
}

.narrative-node__label-field {
    margin: 0;
}

.narrative-node__label-field > #unity-text-input {
    background-color: transparent;
    border-width: 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.12);
    border-radius: 0;
    padding: 1px 2px;
    font-size: 12px;
    -unity-font-style: bold;
    color: #f2f3f7;
}

.narrative-node__label-field > #unity-text-input:hover {
    border-bottom-color: rgba(255, 255, 255, 0.35);
}

.narrative-node__extension {
    padding: 4px 8px 8px 8px;
    background-color: #2b303a;
    border-radius: 0 0 7px 7px;
}

.narrative-node #contents > #top {
    background-color: #2b303a;
}

.narrative-node #contents > #top > #input,
.narrative-node #contents > #top > #output {
    background-color: transparent;
}

.narrative-node #contents > #divider {
    display: none;
}

.narrative-node--note > #node-border {
    background-color: #3a3520;
}

.narrative-node--note .narrative-node__main,
.narrative-node--note .narrative-node__extension,
.narrative-node--note #contents > #top {
    background-color: #3a3520;
}

.narrative-node--obsolete {
    opacity: 0.6;
}

.narrative-node--dimmed {
    opacity: 0.18;
}

.narrative-node--search-match > #node-border {
    border-color: #ffd54a;
    border-width: 2px;
}

.narrative-node--has-warnings > #node-border {
    border-color: rgba(255, 170, 60, 0.7);
}

/* ─── Resumen dentro del nodo ─────────────────────────────────── */

.narrative-summary {
    padding-top: 2px;
}

.summary__text {
    font-size: 11px;
    white-space: normal;
    color: #dfe2ea;
    margin: 1px 0;
}

.summary__strong {
    -unity-font-style: bold;
    color: #f4f5f9;
}

.summary__muted {
    font-size: 10px;
    color: rgba(223, 226, 234, 0.55);
    white-space: normal;
    margin: 1px 0;
}

.summary__error {
    font-size: 10px;
    color: #ff7a7a;
    white-space: normal;
}

.summary__warn {
    font-size: 10px;
    color: #ffb054;
    white-space: normal;
}

.summary__asset-name {
    font-size: 11px;
    -unity-font-style: bold;
    color: #9ed0ff;
}

.summary__dialogue-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 3px;
}

.summary__line {
    flex-direction: row;
    margin: 1px 0;
}

.summary__speaker {
    font-size: 11px;
    -unity-font-style: bold;
    margin-right: 5px;
    min-width: 46px;
}

.summary__speaker--player {
    color: #ffd27a;
}

.summary__speaker--npc {
    color: #9ed0ff;
}

.summary__line > .summary__text {
    flex-shrink: 1;
    flex-grow: 1;
}

.summary__step {
    font-size: 10px;
    color: rgba(223, 226, 234, 0.7);
    white-space: normal;
    margin-left: 4px;
}

.summary__step--hi {
    color: #8fe39a;
    -unity-font-style: bold;
}

.summary__kv {
    flex-direction: row;
    margin: 1px 0;
}

.summary__kv-key {
    font-size: 10px;
    color: rgba(223, 226, 234, 0.55);
    margin-right: 5px;
    min-width: 44px;
}

.summary__kv-value {
    font-size: 11px;
    color: #dfe2ea;
    white-space: normal;
    flex-shrink: 1;
}

.summary__note {
    font-size: 11px;
    white-space: normal;
    color: #f2ecc8;
}

.chip {
    font-size: 10px;
    -unity-font-style: bold;
    border-radius: 9px;
    padding: 2px 8px;
    align-self: flex-start;
    background-color: rgba(255, 255, 255, 0.10);
    color: #e6e8ee;
    margin: 1px 0;
}

.chip--wait {
    background-color: rgba(120, 100, 220, 0.35);
}

.chip--raise {
    background-color: rgba(90, 160, 240, 0.35);
}

.chip--muted {
    background-color: rgba(255, 255, 255, 0.06);
    color: rgba(230, 232, 238, 0.6);
}

/* ─── Avisos en el nodo ───────────────────────────────────────── */

.narrative-node__warnings {
    margin-top: 4px;
    padding: 3px 6px;
    border-radius: 4px;
    background-color: rgba(255, 170, 60, 0.12);
}

.narrative-node__warning {
    font-size: 10px;
    color: #ffb054;
    white-space: normal;
}

/* ─── Puertos ─────────────────────────────────────────────────── */

.narrative-port-dock {
    padding: 2px 2px;
    justify-content: center;
}

.narrative-port-dock--right {
    align-items: flex-end;
}

.narrative-port {
    height: 20px;
}

.narrative-port > #connector {
    width: 12px;
    height: 12px;
    border-radius: 6px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.55);
    background-color: rgba(255, 255, 255, 0.10);
}

.narrative-port:hover > #connector {
    background-color: rgba(255, 255, 255, 0.55);
}

.narrative-port > #type {
    font-size: 10px;
    color: rgba(230, 232, 238, 0.85);
    margin: 0 4px;
}

.narrative-port--named > #type {
    -unity-font-style: bold;
}

.narrative-node__fork-badge {
    font-size: 9px;
    -unity-font-style: bold;
    color: #1e2128;
    background-color: #ffb054;
    border-radius: 3px;
    padding: 1px 5px;
    margin: 2px 4px;
    align-self: flex-end;
}

/* ─── Aristas ─────────────────────────────────────────────────── */

.narrative-edge--dimmed {
    opacity: 0.1;
}

/* ─── Inspector (derecha) ─────────────────────────────────────── */

.narrative-inspector {
    background-color: #262a33;
    border-left-width: 1px;
    border-left-color: #14161b;
    min-width: 280px;
}

.narrative-inspector__header {
    font-size: 13px;
    -unity-font-style: bold;
    padding: 8px 10px;
    border-left-width: 5px;
    background-color: #2b303a;
    border-bottom-width: 1px;
    border-bottom-color: #14161b;
}

.narrative-inspector__scroll {
    flex-grow: 1;
}

.narrative-inspector__description {
    font-size: 11px;
    color: rgba(230, 232, 238, 0.6);
    white-space: normal;
    padding: 6px 10px 2px 10px;
    -unity-font-style: italic;
}

.narrative-inspector__hint {
    font-size: 11px;
    color: rgba(230, 232, 238, 0.55);
    white-space: normal;
    padding: 12px;
}

.narrative-inspector__section {
    margin: 4px 6px;
}

.narrative-inspector__section > Toggle {
    -unity-font-style: bold;
    font-size: 11px;
}

.narrative-inspector__section > #unity-content {
    padding: 4px 2px 6px 8px;
    margin-left: 0;
}

.narrative-inspector__row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin: 2px 0;
}

.narrative-inspector__asset-name {
    font-size: 12px;
    -unity-font-style: bold;
    color: #9ed0ff;
    white-space: normal;
    flex-shrink: 1;
}

.narrative-inspector__script {
    margin-top: 4px;
    padding: 4px;
    border-radius: 4px;
    background-color: rgba(0, 0, 0, 0.2);
}

.narrative-inspector__script-line {
    flex-direction: row;
    padding: 3px 2px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.05);
}

.narrative-inspector__script-num {
    font-size: 10px;
    color: rgba(230, 232, 238, 0.4);
    min-width: 18px;
    margin-right: 4px;
}

.narrative-inspector__link {
    -unity-text-align: middle-left;
    margin: 1px 0;
    padding: 2px 6px;
    font-size: 11px;
    background-color: rgba(255, 255, 255, 0.06);
    border-width: 0;
    border-radius: 3px;
    white-space: normal;
}

.narrative-inspector__link:hover {
    background-color: rgba(255, 255, 255, 0.14);
}
