        accent: {r: 1, g: 0.93, b: 0.55, a: 1}
    - rid: 6540294316048253091
      type: {class: GraphNoteNode, ns: , asm: Assembly-CSharp}
      data:
        displayTitle: Nota
        chapter: Chuchelandia
