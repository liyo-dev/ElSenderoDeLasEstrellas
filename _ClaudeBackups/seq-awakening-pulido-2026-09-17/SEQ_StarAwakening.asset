  m_Script: {fileID: 11500000, guid: bce0c04b63bb2b54ea79195a041cd17d, type: 3}
  m_Name: SEQ_StarAwakening
  m_EditorClassIdentifier: 
  displayName: El Despertar de la Estrella
  summary: 'Eldran avisa. Will se gira y ve venir el proyectil. Eldran sale corriendo
    a esconderse gritandole que se aparte, y Will se queda solo: primer plano de
    su cara, la camara retrocede hasta verle entero y se planta en pose de combate.
    El plano se abre a general y ahi el jugador tiene que reaccionar. Si acierta,
    devuelve el golpe; si falla, el grafo vuelve al dialogo con Eldran. Ningun plano
    esta colocado a mano.'
  signalIn: AWAKEN_START
  signalOut: AWAKEN_DONE
  musicId: AWAKEN
  openingShotName: 
  openingShot:
    type: 3
    subjectId: NPC_Eldran
    secondaryId: Player
    heightBias: 0
    distanceScale: 1
    fovOverride: 0
    crossTheLine: 0
    headroom: 1
  endStayBlack: 1
  phases:
